        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "showUnfilled": true,
        "valueMode": "color"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "topk(15, sum by (ip) (count_over_time({job=\"tron-legacy-api\"} | json | ip!=\"\" [$__range])))",
          "legendFormat": "{{ip}}",
          "refId": "A"
        }
      ],
