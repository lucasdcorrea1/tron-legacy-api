      "targets": [
        {
          "expr": "sum by (status) (count_over_time({job=\"tron-legacy-api\"} | json | status=~\"429|403|5..\" [1m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "title": "Taxa de Respostas Suspeitas (429/403/5xx)",
      "type": "timeseries"
    },
