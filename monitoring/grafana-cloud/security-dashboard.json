      "targets": [
        {
          "expr": "topk(15, sum by (ip) (count_over_time({job=\"tron-legacy-api\"} | json | status=~\"429|403\" [$__range])))",
          "legendFormat": "{{ip}}",
          "refId": "A"
        }
